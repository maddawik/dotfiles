[user]
  name = maddawik
  email = edwardreillycomputers@gmail.com
  signingKey = 1208B7724BB2E9CA
[gpg]
  program = gpg
[commit]
  gpgsign = true
[tag]
  gpgSign = true
[core]
  editor = nvim
  pager = delta
[diff]
  tool = nvimdiff
  colorMoved = default
  algorithm = histogram
[init]
  defaultBranch = main
{{- /* Only rewrite to ssh once the key is on disk. On a fresh machine this keeps
       brew, taps and chezmoi itself on https until 1Password has written it. */}}
{{- if stat (joinPath .chezmoi.homeDir ".ssh" "id_ed25519") }}
[url "git@gitlab.com:"]
  insteadOf = https://gitlab.com/
[url "git@github.com:"]
  insteadOf = https://github.com/
{{- end }}

[push]
  useForceIfIncludes = true
  autoSetupRemote = true
[pull]
  rebase = false
  ff = only
[fetch]
  prune = true
  pruneTags = true
[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true
[branch]
  sort = -committerdate
[interactive]
  diffFilter = delta --color-only
[add.interactive]
  useBuiltin = false

[include]
  path = .config/delta/tokyonight-moon.gitconfig
[delta]
  features = tokyonight-moon
  light = false
  navigate = true
  hyperlinks = true
  file-added-label = [●]
  file-copied-label = [C]
  file-modified-label = [+]
  file-removed-label = [⛌]
  file-renamed-label = [→]
  side-by-side = false
  line-numbers = true
  line-numbers-left-format = "{nm:^4}"
  line-numbers-right-format = "┊{np:^4}│"
[merge]
  conflictstyle = zdiff3


[includeIf "hasconfig:remote.*.url:git@github.com:vulncheck/**"]
  path = ~/work/.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/vulncheck/**"]
  path = ~/work/.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:vulncheck-oss/**"]
  path = ~/work/.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/vulncheck-oss/**"]
  path = ~/work/.gitconfig

[includeIf "hasconfig:remote.*.url:git@github.com:maddawik/obsidian-**"]
  path = ~/.config/git/vaults.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/maddawik/obsidian-**"]
  path = ~/.config/git/vaults.gitconfig
