#!/bin/bash

set -eufo pipefail

# A fresh Mac has no Homebrew yet; chezmoi itself comes from the curl installer.
if [[ ! -x /opt/homebrew/bin/brew ]]; then
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"

# ~/.gitconfig rewrites github https URLs to ssh; brew taps must clone over
# https since the ssh key may not exist yet on a first apply.
export GIT_CONFIG_GLOBAL=/dev/null

{{ $taps := list
     "FelixKratz/formulae"
     "nikitabobko/tap" -}}
{{ $brews := list
     "ast-grep"
     "bat"
     "btop"
     "bun"
     "chezmoi"
     "cmake"
     "delve"
     "dive"
     "dockutil"
     "dust"
     "duf"
     "entr"
     "eza"
     "fd"
     "ffmpeg"
     "fish"
     "fzf"
     "gh"
     "git"
     "git-delta"
     "glow"
     "go"
     "go-task"
     "golangci-lint"
     "goreleaser"
     "hub"
     "imagemagick"
     "jless"
     "jq"
     "lazydocker"
     "lazygit"
     "media-control"
     "mise"
     "moreutils"
     "neovim"
     "pinentry-mac"
     "pipx"
     "presenterm"
     "rip2"
     "ripgrep"
     "tealdeer"
     "terminal-notifier"
     "tmux"
     "tokei"
     "tree-sitter-cli"
     "uv"
     "vivid"
     "websocat"
     "wget"
     "xh"
     "yamllint"
     "yazi"
     "yq"
     "yt-dlp"
     "zig"
     "felixkratz/formulae/sketchybar" -}}
{{ $casks := list
     "1password"
     "1password-cli"
     "betterdisplay"
     "brave-browser"
     "caffeine"
     "claude-code@latest"
     "docker-desktop"
     "firefox"
     "font-hack-nerd-font"
     "font-jetbrains-mono"
     "font-sketchybar-app-font"
     "font-symbols-only-nerd-font"
     "ghostty"
     "obsidian"
     "raycast"
     "shottr"
     "visual-studio-code"
     "nikitabobko/tap/aerospace" -}}

{{ if .work -}}
{{   $taps = concat $taps (list
       "common-fate/granted"
       "fluxcd/tap"
       "hashicorp/tap"
       "warrensbox/tap") -}}
{{   $brews = concat $brews (list
       "awscli"
       "doctl"
       "eksctl"
       "granted"
       "helm"
       "k9s"
       "mage"
       "poetry"
       "sops"
       "terragrunt"
       "fluxcd/tap/flux"
       "hashicorp/tap/packer"
       "warrensbox/tap/tfswitch") -}}
{{   $casks = concat $casks (list
       "gcloud-cli"
       "microsoft-teams"
       "pritunl"
       "slack") -}}
{{ end -}}

{{ if .personal -}}
{{   $casks = concat $casks (list
       "discord"
       "obs"
       "plex") -}}
{{ end -}}

{{ if .ephemeral -}}
{{   $casks = list -}}
{{ end -}}

brew bundle --file=/dev/stdin <<EOF
{{ range ($taps | sortAlpha | uniq) -}}
tap "{{ . }}"
{{ end -}}
{{ range ($brews | sortAlpha | uniq) -}}
brew "{{ . }}"
{{ end -}}
{{ range ($casks | sortAlpha | uniq) -}}
cask "{{ . }}"
{{ end -}}
EOF
