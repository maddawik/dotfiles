#!/bin/bash
# Rebuild bat's theme cache so custom themes in ~/.config/bat/themes are usable.
# Re-runs whenever a theme file changes:
{{ range glob (joinPath .chezmoi.sourceDir "dot_config/bat/themes/*") -}}
# {{ base . }} {{ include . | sha256sum }}
{{ end -}}
set -eufo pipefail

# Scripts inherit the caller's PATH; a fresh zsh has no brew in it yet.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v bat >/dev/null 2>&1; then
  echo "setup-bat-cache: bat not installed, skipping" >&2
  exit 0
fi

bat cache --build
