#!/bin/bash
# Install fisher and the plugins listed in fish_plugins, then set tide's layout.
# Re-runs when fish_plugins changes.
# fish_plugins: {{ include "dot_config/private_fish/fish_plugins" | sha256sum }}
set -eufo pipefail

# Scripts inherit the caller's PATH; a fresh zsh has no brew in it yet.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

if ! command -v fish >/dev/null 2>&1; then
  echo "fish-plugins: fish not installed, skipping" >&2
  exit 0
fi

# fisher bootstraps itself; afterwards `fisher update` installs everything in fish_plugins.
if ! fish -c 'functions -q fisher'; then
  fish -c 'curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source && fisher update'
else
  fish -c 'fisher update'
fi

# tide stores its layout in universal variables; these flags reproduce the
# lean/two-line/few-icons setup. Extra items come from conf.d/tide.fish.
fish -c "tide configure --auto \
  --style=Lean \
  --prompt_colors='16 colors' \
  --show_time=No \
  --lean_prompt_height='Two lines' \
  --prompt_connection=Disconnected \
  --prompt_spacing=Compact \
  --icons='Few icons'"

echo "fish-plugins: done"
