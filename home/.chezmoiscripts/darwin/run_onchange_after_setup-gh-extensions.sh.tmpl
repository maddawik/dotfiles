#!/bin/bash
# Install gh extensions at pinned release tags. They run as you with your gh
# token, so they never follow "latest". Re-runs when this list changes; an
# extension at a different version (or unpinned) is reinstalled at its pin.
# To upgrade: bump the tag here after reading the release.
set -eufo pipefail

# Scripts inherit the caller's PATH; a fresh zsh has no brew in it yet.
[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

EXTENSIONS=(
  dlvhdr/gh-dash@v4.19.1
  dlvhdr/gh-enhance@v0.8.1
  github/gh-stack@v0.2.1
)

if ! command -v gh >/dev/null 2>&1; then
  echo "setup-gh-extensions: gh not installed, skipping" >&2
  exit 0
fi

if ! gh auth status >/dev/null 2>&1; then
  echo "setup-gh-extensions: gh not logged in, skipping (run gh auth login, then chezmoi apply)" >&2
  exit 0
fi

# Columns: name, owner/repo, version
installed=$(gh extension list)

for ext in "${EXTENSIONS[@]}"; do
  repo=${ext%@*}
  tag=${ext#*@}
  have=$(awk -F'\t' -v r="$repo" '$2 == r { print $3 }' <<<"$installed")
  # Only a pinned install is skipped by `gh extension upgrade --all`; the
  # same version installed without --pin would still drift.
  manifest="${XDG_DATA_HOME:-$HOME/.local/share}/gh/extensions/${repo#*/}/manifest.yml"
  if [[ "$have" == "$tag" ]] && grep -qx 'ispinned: true' "$manifest" 2>/dev/null; then
    echo "setup-gh-extensions: $repo already pinned at $tag"
    continue
  fi
  if [[ -n "$have" ]]; then
    echo "setup-gh-extensions: $repo is at ${have}, reinstalling at $tag"
    gh extension remove "${repo#*/}"
  fi
  gh extension install "$repo" --pin "$tag"
done
