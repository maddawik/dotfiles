PLUGIN_DIR="$CONFIG_DIR/plugins"

##### TokyoNight Moon #####
TN_BG=0xff222436
TN_BG_DARK=0xff1e2030
TN_HL=0xff2f334d
TN_FG=0xffc8d3f5
TN_MUTED=0xff828bb8
TN_COMMENT=0xff636da6

TN_BLUE=0xff82aaff
TN_CYAN=0xff86e1fc
TN_GREEN=0xffc3e88d
TN_MAGENTA=0xffc099ff
TN_YELLOW=0xffffc777
TN_RED=0xffff757f
TN_ORANGE=0xffff966c
TN_PURPLE=0xfffca7ea

##### Bar Appearance #####
# Floating rounded bar, Moon bg with soft border.
# height stays 33 so it keeps lining up with the notch/camera.
BAR_HEIGHT=33
BAR_RADIUS=14
# Match AeroSpace's gaps.outer (see ~/.aerospace.toml) so the bands line up
# with the window edges.
BAR_MARGIN=10 # inset from the left/right screen edges
BAR_TOP_PAD=10 # matching inset from the top edge
BAND_COLOR=0x54222436
BAND_BORDER=0x40636da6

# The bar itself is an invisible container -- the two bands below draw the
# visible chrome, so the middle stays open for the laptop camera.
sketchybar --bar \
  position=top \
  height=$BAR_HEIGHT \
  margin=$BAR_MARGIN \
  y_offset=$BAR_TOP_PAD \
  padding_left=0 \
  padding_right=0 \
  corner_radius=$BAR_RADIUS \
  border_width=0 \
  blur_radius=15 \
  color=0x00000000

##### Changing Defaults #####
default=(
  padding_left=4
  padding_right=4
  icon.font="Hack Nerd Font:Bold:16.0"
  label.font="Hack Nerd Font:Bold:16.0"
  icon.color=$TN_MUTED
  label.color=$TN_FG
  icon.padding_left=2
  icon.padding_right=4
  label.padding_left=2
  label.padding_right=2
)
sketchybar --default "${default[@]}"

##### Shared item styling #####
# sketchybar-app-font renders ":appname:" ligatures as app icons.
# Install: brew install --cask font-sketchybar-app-font
APP_FONT="sketchybar-app-font:Regular:16.0"

PILL_COLOR=0x732f334d
PILL_RADIUS=9
PILL_HEIGHT=26
PILL_INSET_L=10
PILL_INSET_R=10
PILL_BORDER_WIDTH=1
PILL_BORDER_COLOR=0x99636da6

# Battery present?
HAS_BATTERY=0
pmset -g batt 2>/dev/null | grep -q "InternalBattery" && HAS_BATTERY=1

pill=(
  background.drawing=on
  background.color=$PILL_COLOR
  background.corner_radius=$PILL_RADIUS
  background.height=$PILL_HEIGHT
  background.border_width=$PILL_BORDER_WIDTH
  background.border_color=$PILL_BORDER_COLOR

  background.padding_left=$PILL_INSET_L
  background.padding_right=$PILL_INSET_R

  icon.padding_left=$PILL_INSET_L
  label.padding_right=$PILL_INSET_R

  label.color=$TN_FG
)

# Bracket pill style (for cpu+memory group)
group_pill=(
  background.drawing=on
  background.color=$PILL_COLOR
  background.corner_radius=$PILL_RADIUS
  background.height=$PILL_HEIGHT
  background.border_width=$PILL_BORDER_WIDTH
  background.border_color=$PILL_BORDER_COLOR
)

##### Adding Left Items #####

# Aerospace
sketchybar --add event aerospace_workspace_change
# 'aerospace list-workspaces --all' only reports workspaces that currently
# exist (AeroSpace creates them lazily), so empty ones would vanish from the
# bar. Read the configured set straight from the keybindings instead.
WORKSPACES=$(sed -n "s/^alt-[0-9]* = 'workspace \\([^']*\\)'/\\1/p" "$HOME/.aerospace.toml" | sort -n -u)
[ -z "$WORKSPACES" ] && WORKSPACES=$(aerospace list-workspaces --all | sort -n)
WORKSPACES=$(echo $WORKSPACES) # collapse newlines; this goes into a script= string

SPACE_ITEMS=""
for sid in $WORKSPACES; do
  SPACE_ITEMS="$SPACE_ITEMS space.$sid"
  sketchybar --add item space.$sid left \
    --set space.$sid \
    background.color=0x2682aaff \
    background.corner_radius=7 \
    background.height=24 \
    background.border_width=1 \
    background.border_color=0x0082aaff \
    background.drawing=off \
    icon="$sid" \
    icon.color=$TN_MUTED \
    icon.padding_left=8 \
    icon.padding_right=8 \
    click_script="aerospace workspace $sid"
done

# One script updates every indicator in a single batched pass -- see the note in
# plugins/aerospace.sh about why this is not a per-item script. It hangs off the
# first workspace item because sketchybar runs neither --update nor event scripts
# for items with drawing=off, so a hidden watcher item would never fire.
FIRST_WS=${WORKSPACES%% *}
sketchybar --set space.$FIRST_WS \
  script="$PLUGIN_DIR/aerospace.sh $WORKSPACES" \
  --subscribe space.$FIRST_WS aerospace_workspace_change front_app_switched

sketchybar --add item front_app left \
  --set front_app "${pill[@]}" \
  icon.font="$APP_FONT" \
  icon.color=$TN_BLUE \
  label.color=$TN_FG \
  script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

##### Adding Right Items #####

# Right items
sketchybar \
  --add item clock right \
  --set clock "${pill[@]}" \
  update_freq=10 icon= icon.color=$TN_BLUE script="$PLUGIN_DIR/clock.sh" \
  --add item volume right \
  --set volume "${pill[@]}" \
  icon.color=$TN_CYAN script="$PLUGIN_DIR/volume.sh" \
  --subscribe volume volume_change \
  --add item cpu right \
  --set cpu \
  background.drawing=off \
  padding_left=0 \
  icon.padding_left=$PILL_INSET_L \
  label.padding_left=0 \
  label.color=$TN_FG \
  update_freq=2 icon= icon.color=$TN_GREEN script="$PLUGIN_DIR/cpu.sh" \
  --add item memory right \
  --subscribe memory mouse.entered mouse.exited mouse.exited.global \
  --set memory \
  background.drawing=off \
  padding_right=0 \
  icon.padding_right=0 \
  label.padding_right=$PILL_INSET_R \
  label.color=$TN_FG \
  update_freq=2 icon= icon.color=$TN_MAGENTA script="$PLUGIN_DIR/memory.sh"

# One shared pill for CPU + Memory
sketchybar --add bracket sys_group cpu memory \
  --set sys_group "${group_pill[@]}"

# Battery
if [ "$HAS_BATTERY" -eq 1 ]; then
  sketchybar --add item battery right \
    --set battery "${pill[@]}" \
    icon.color=$TN_YELLOW \
    update_freq=120 script="$PLUGIN_DIR/battery.sh" \
    --subscribe battery system_woke power_source_change
fi

##### Split bar halves #####
# The bar's own background is a single edge-to-edge band, so it cannot be
# broken around the camera. These two brackets draw the band instead, leaving
# the middle of the bar open.
band=(
  background.drawing=on
  background.color=$BAND_COLOR
  background.border_color=$BAND_BORDER
  background.border_width=1
  background.corner_radius=$BAR_RADIUS
  background.height=$BAR_HEIGHT
)

RIGHT_ITEMS="clock volume cpu memory"
[ "$HAS_BATTERY" -eq 1 ] && RIGHT_ITEMS="$RIGHT_ITEMS battery"

sketchybar --add bracket left_band $SPACE_ITEMS front_app \
  --set left_band "${band[@]}" \
  --add bracket right_band $RIGHT_ITEMS \
  --set right_band "${band[@]}"

##### Force all scripts to run the first time #####
sketchybar --update
